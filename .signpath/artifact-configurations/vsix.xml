<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <opc-file path="*.vsix" max-matches="unbounded">
      <!-- Each VSIX contains a different subset of our own assemblies -->
      <pe-file path="ApiClientCodeGenerator.dll" min-matches="0" max-matches="unbounded">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="ApiClientCodeGen.VSIX.Extensibility.dll" min-matches="0" max-matches="unbounded">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="Rapicgen.Core.dll" min-matches="0" max-matches="unbounded">
        <authenticode-sign/>
      </pe-file>
      <opc-sign/>
    </opc-file>
  </zip-file>
</artifact-configuration>
